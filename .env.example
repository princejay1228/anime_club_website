# Copy these names into Vercel > Project > Settings > Environment Variables.
# Never commit real values. Every variable here is SERVER-ONLY (used by /api functions).
# The browser only uses the public URL + publishable key in assets/club/config.js.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://kfpcqjjwsrveqzlzvlml.supabase.co
# The "sb_secret_..." key (Project Settings > API Keys > Secret keys). Server only, never in config.js.
SUPABASE_SECRET_KEY=paste-sb_secret-key-here

# --- Weekly cron protection: any long random string (e.g. `openssl rand -hex 32`) ---
CRON_SECRET=paste-a-long-random-string-here

# --- Events source: set ONE of the two options ---
# Option 1 (recommended): private Google Sheet shared (Viewer) with a service account
EVENTS_SHEET_ID=the-long-id-between-/d/-and-/edit-in-the-sheet-link
EVENTS_SHEET_RANGE=Events
GOOGLE_SERVICE_ACCOUNT_EMAIL=club-sync@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\npaste-the-private_key-value-from-the-json-file\n-----END PRIVATE KEY-----\n"
# Option 2: a sheet published to the web as CSV (anyone with the link can read it)
EVENTS_CSV_URL=

# --- Admin email when someone asks to join (https://resend.com, free tier) ---
RESEND_API_KEY=paste-resend-api-key-here
ADMIN_EMAIL=animeclubsimats@gmail.com
# Until you verify a domain in Resend, keep the default sender below.
NOTIFY_FROM=SIMATS Anime Club <onboarding@resend.dev>
SITE_URL=https://simats-anime-club.vercel.app
